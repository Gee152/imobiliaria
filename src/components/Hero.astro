---
import { ArrowDown, MessageSquare, ShieldCheck, MapPin, Award, ArrowUpRight } from 'lucide-react';
import Tatiana from '../assets/tatiana.jpeg';

const whatsappUrl = "https://wa.me/5581997459932?text=Ol%C3%A1%2C%20Tatiana!%20Vi%20seu%20site%20e%20gostaria%20de%20ajuda%20para%20encontrar%20um%20im%C3%B3vel.";
---

<section id="hero" class="relative overflow-hidden pt-8 pb-16 md:pt-20 md:pb-28 bg-[#FAF7F2]">
  {/* Subtle architectural backdrop lines */}
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5DBD0_1px,transparent_1px),linear-gradient(to_bottom,#E5DBD0_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none" />

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      
      {/* Left Content Column */}
      <div class="lg:col-span-7 flex flex-col justify-center text-left">
        
        {/* Pill Tag (Hidden on mobile) */}
        <div class="hidden sm:inline-flex items-center space-x-2.5 bg-[#F2ECE3] border border-[#E5DBD0] px-4 py-1.5 rounded-full w-fit mb-4 sm:mb-6 shadow-xs side-down-dynamic delay-75">
          <span class="w-2 h-2 rounded-full bg-[#C85A32]" />
          <span class="text-xs uppercase tracking-widest text-[#4A2E22] font-semibold">
            Zona Norte do Recife • CRECI 8988
          </span>
        </div>

        {/* DESKTOP ONLY: H1 Main Headline */}
        <h1 class="hidden lg:block font-display text-5xl lg:text-6xl font-medium tracking-tight text-[#26160F] leading-[1.12] mb-6 side-down-dynamic delay-100">
          Seu próximo imóvel começa com uma <span class="italic text-[#C85A32] font-normal">escolha segura</span>.
        </h1>

        {/* DESKTOP ONLY: Subheadline above CTAs */}
        <p class="hidden lg:block font-body text-base sm:text-lg lg:text-xl text-[#5A544F] leading-relaxed mb-8 max-w-2xl side-down-dynamic delay-150">
          Há 15 anos ajudando pessoas a encontrar, negociar e conquistar seu imóvel na Zona Norte do Recife — <strong class="text-[#26160F] font-semibold">do interesse ao registro</strong>.
        </p>

        {/* MOBILE ONLY: Image Div with Headline and CTAs inside */}
        <div class="block lg:hidden mb-6 side-down-dynamic delay-100">
          <div class="relative bg-[#26160F] rounded-3xl p-2.5 sm:p-4 shadow-xl overflow-hidden border border-[#351F16] card-dynamic">
            <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-[#351F16]">
              <img
                src={Tatiana.src}
                alt="Tatiana Cavalcanti - Corretora de Imóveis CRECI 8988"
                class="w-full h-full object-cover object-top filter contrast-[1.03]"
                loading="eager"
              />
              
              {/* Bottom gradient scrim for high contrast on headline and buttons */}
              <div class="absolute inset-0 bg-gradient-to-t from-[#140A06]/95 via-[#140A06]/55 to-transparent pointer-events-none" />

              {/* Top Badge: Tatiana Cavalcanti */}
              <div class="absolute top-3 left-3 z-10 bg-[#26160F]/85 backdrop-blur-md border border-white/10 px-3 py-1.5 rounded-full text-white text-[11px] font-medium flex items-center space-x-1.5 shadow-md">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C85A32]"></span>
                <span>Tatiana Cavalcanti • CRECI 8988</span>
              </div>

              {/* MOBILE ONLY: Headline & CTAs over the image above buttons */}
              <div class="absolute bottom-0 inset-x-0 p-3 sm:p-4 z-20 flex flex-col justify-end gap-3 pointer-events-none">
                {/* Mobile H1 Headline */}
                <div class="pointer-events-auto">
                  <h1 class="font-display text-[22px] sm:text-2xl font-medium text-white tracking-tight leading-[1.2] drop-shadow-md">
                    Seu próximo imóvel começa com uma <span class="italic text-[#FF9E7D] font-normal">escolha segura</span>.
                  </h1>
                </div>

                {/* CTAs SIDE-BY-SIDE directly below headline */}
                <div class="flex flex-row items-center gap-2 pointer-events-auto">
                  <a
                    href="#imoveis"
                    class="flex-1 inline-flex items-center justify-center space-x-1.5 bg-[#C85A32] hover:bg-[#AB4823] text-white px-2.5 py-3 rounded-xl text-xs font-semibold shadow-lg shadow-black/50 transition-all touch-target active:scale-95 whitespace-nowrap"
                  >
                    <span>Encontrar imóvel</span>
                    <ArrowDown className="w-3.5 h-3.5 shrink-0" />
                  </a>

                  <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center space-x-1.5 bg-black/65 hover:bg-black/85 backdrop-blur-md text-white border border-white/25 px-2.5 py-3 rounded-xl text-xs font-medium shadow-lg shadow-black/50 transition-all touch-target active:scale-95 whitespace-nowrap"
                  >
                    <MessageSquare className="w-3.5 h-3.5 text-[#FF9E7D] shrink-0" />
                    <span>Falar com Tatiana</span>
                    <ArrowUpRight className="w-3 h-3 text-white/70 shrink-0" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* MOBILE ONLY: Subheadline text moved below the image */}
        <p class="block lg:hidden font-body text-sm sm:text-base text-[#5A544F] leading-relaxed mb-6 side-down-dynamic delay-150">
          Há 15 anos ajudando pessoas a encontrar, negociar e conquistar seu imóvel na Zona Norte do Recife — <strong class="text-[#26160F] font-semibold">do interesse ao registro</strong>.
        </p>

        {/* DESKTOP ONLY: CTAs in left column */}
        <div class="hidden lg:flex flex-row items-center gap-4 mb-10 side-down-dynamic delay-200">
          <a
            href="#imoveis"
            class="inline-flex items-center justify-center space-x-3 bg-[#C85A32] hover:bg-[#AB4823] text-white px-8 py-4 rounded-xl text-base font-semibold shadow-md shadow-[#C85A32]/20 transition-all duration-200 touch-target active:scale-95 text-center"
          >
            <span>Encontrar meu imóvel</span>
            <ArrowDown className="w-4 h-4" />
          </a>

          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center space-x-2 bg-transparent hover:bg-[#F2ECE3] text-[#26160F] border border-[#26160F]/30 px-6 py-4 rounded-xl text-base font-medium transition-all duration-200 touch-target active:scale-95 text-center"
          >
            <MessageSquare className="w-4 h-4 text-[#C85A32]" />
            <span>Falar com Tatiana</span>
            <ArrowUpRight className="w-4 h-4 text-[#6E6760]" />
          </a>
        </div>

        {/* Trust & Authority Indicators (Mobile & Desktop) */}
        <div class="pt-6 border-t border-[#E5DBD0] grid grid-cols-3 gap-4 sm:gap-6 side-down-dynamic delay-250">
          <div class="card-dynamic p-1.5 rounded-xl transition-all">
            <span class="block font-display text-2xl sm:text-3xl font-semibold text-[#26160F]">
              <span class="metric-counter" data-counter-target="15">0</span> anos
            </span>
            <span class="text-xs text-[#6E6760] font-medium leading-tight">
              De experiência de mercado
            </span>
          </div>

          <div class="card-dynamic p-1.5 rounded-xl transition-all">
            <span class="block font-display text-2xl sm:text-3xl font-semibold text-[#26160F]">
              <span class="metric-counter" data-counter-target="100">0</span>%
            </span>
            <span class="text-xs text-[#6E6760] font-medium leading-tight">
              Acompanhamento até o registro
            </span>
          </div>

          <div class="card-dynamic p-1.5 rounded-xl transition-all">
            <span class="block font-display text-2xl sm:text-3xl font-semibold text-[#26160F]">
              Zona Norte
            </span>
            <span class="text-xs text-[#6E6760] font-medium leading-tight">
              Especialista regional no Recife
            </span>
          </div>
        </div>

      </div>

      {/* DESKTOP ONLY: Right Visual Column */}
      <div class="hidden lg:block lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          {/* Main Card with Picture & Architectural Texture */}
          <div class="relative bg-[#26160F] rounded-3xl p-3 sm:p-4 shadow-2xl overflow-hidden border border-[#351F16] card-dynamic side-down-dynamic delay-150">
            
            {/* Image Container with Luxury Overlay */}
            <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-[#351F16]">
              <img
                src={Tatiana.src}
                alt="Tatiana Cavalcanti - Corretora de Imóveis CRECI 8988"
                class="w-full h-full object-cover object-top filter contrast-[1.03]"
                loading="eager"
              />
              
              {/* Subtle gradient scrim */}
              <div class="absolute inset-0 bg-gradient-to-t from-[#1A0E09] via-transparent to-transparent opacity-80" />

              {/* In-image caption tag */}
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#26160F]/85 backdrop-blur-md border border-white/10 text-white">
                <div class="flex items-center justify-between">
                  <div>
                    <h2 class="font-display text-lg font-medium text-white">
                      Tatiana Cavalcanti
                    </h2>
                    <p class="text-xs text-white/70">
                      Consultoria Imobiliária Pessoal • CRECI 8988
                    </p>
                  </div>
                  <span class="w-8 h-8 rounded-full bg-[#C85A32] flex items-center justify-center text-white">
                    <ShieldCheck className="w-4 h-4" />
                  </span>
                </div>
              </div>
            </div>

          </div>

          {/* Floating Pill: Concept Badge */}
          <div class="absolute -top-4 -right-4 sm:-right-6 z-20 side-down-dynamic delay-200 pointer-events-auto">
            <div 
              class="bg-[#FAF7F2] border border-[#E5DBD0] p-3 rounded-2xl shadow-xl flex items-center space-x-3 card-dynamic"
              data-parallax="-0.08"
            >
              <div class="w-9 h-9 rounded-xl bg-[#C85A32]/10 flex items-center justify-center text-[#C85A32]">
                <Award className="w-5 h-5" />
              </div>
              <div class="text-left">
                <span class="block text-[11px] font-semibold text-[#26160F] uppercase tracking-wider">
                  Só é dono quem registra
                </span>
                <span class="block text-[10px] text-[#6E6760]">
                  Segurança jurídica de ponta a ponta
                </span>
              </div>
            </div>
          </div>

          {/* Floating Pill: Location Badge */}
          <div class="absolute -bottom-6 -left-4 sm:-left-6 z-20 side-down-dynamic delay-250 pointer-events-auto">
            <div 
              class="bg-[#FAF7F2] border border-[#E5DBD0] p-3 rounded-2xl shadow-xl flex items-center space-x-3 card-dynamic"
              data-parallax="0.08"
            >
              <div class="w-9 h-9 rounded-xl bg-[#C85A32]/10 flex items-center justify-center text-[#C85A32]">
                <MapPin className="w-5 h-5" />
              </div>
              <div class="text-left">
                <span class="block text-[11px] font-semibold text-[#26160F] uppercase tracking-wider">
                  Recife — Zona Norte
                </span>
                <span class="block text-[10px] text-[#6E6760]">
                  Casa Forte, Graças, Jaqueira e região
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
