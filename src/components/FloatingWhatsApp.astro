---
const whatsappUrl = "https://wa.me/5581997459932?text=Ol%C3%A1%2C%20Tatiana!%20Vi%20seu%20site%20e%20gostaria%20de%20ajuda%20para%20encontrar%20um%20im%C3%B3vel.";
---

<aside 
  id="floating-whatsapp" 
  class="fixed bottom-[5.5rem] right-5 sm:bottom-6 sm:right-6 flex items-center justify-end group transition-all duration-300 ease-out pointer-events-auto"
  aria-label="Atendimento direto via WhatsApp"
>
  
  {/* Tooltip / Label on hover (Desktop) */}
  <div class="hidden sm:block opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0 mr-3 pointer-events-none">
    <div class="bg-[#26160F] text-white text-xs font-semibold px-3.5 py-2 rounded-xl shadow-xl border border-white/10 whitespace-nowrap flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
      <span>Falar com Tatiana no WhatsApp</span>
    </div>
  </div>

  {/* Circular Button Wrapper with Pulsating Ripple Rings */}
  <div class="relative flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16">
    
    {/* Continuous Ripple Pulse Ring 1 */}
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-75 whatsapp-pulse-ring-1 pointer-events-none"></span>
    
    {/* Continuous Ripple Pulse Ring 2 */}
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-50 whatsapp-pulse-ring-2 pointer-events-none"></span>

    {/* Main Circular WhatsApp Floating Action Button */}
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="whatsapp-fab-button relative z-10 rounded-full text-white flex items-center justify-center transition-transform duration-300 hover:scale-110 active:scale-95 touch-target focus:outline-none focus:ring-4 focus:ring-[#25D366]/30 cursor-pointer"
      aria-label="Falar no WhatsApp com Tatiana Cavalcanti"
    >
      {/* Official WhatsApp Vector Logo */}
      <svg 
        class="w-7 h-7 sm:w-8 sm:h-8 fill-current text-white shrink-0 pointer-events-none" 
        viewBox="0 0 24 24" 
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 20.16C10.57 20.16 9.12 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.05 20.16ZM16.57 14.39C16.32 14.26 15.1 13.66 14.88 13.58C14.65 13.5 14.48 13.46 14.32 13.71C14.15 13.96 13.68 14.51 13.54 14.67C13.4 14.84 13.25 14.86 13 14.73C12.75 14.61 11.71 14.27 10.48 13.17C9.52 12.31 8.87 11.25 8.73 11C8.59 10.75 8.71 10.62 8.84 10.49C8.95 10.38 9.09 10.2 9.21 10.05C9.33 9.9 9.38 9.79 9.46 9.63C9.54 9.46 9.5 9.32 9.44 9.2C9.38 9.07 8.87 7.82 8.66 7.31C8.45 6.81 8.24 6.88 8.08 6.87C7.93 6.86 7.76 6.86 7.59 6.86C7.42 6.86 7.15 6.92 6.92 7.17C6.69 7.42 6.04 8.03 6.04 9.26C6.04 10.49 6.94 11.68 7.06 11.84C7.18 12.01 8.82 14.53 11.33 15.61C11.92 15.87 12.38 16.02 12.74 16.14C13.34 16.33 13.88 16.3 14.31 16.24C14.79 16.17 15.79 15.64 16 15.05C16.21 14.45 16.21 13.94 16.15 13.84C16.09 13.73 15.92 13.66 15.67 13.54L16.57 14.39Z"/>
      </svg>

      {/* Online / Notification Pip */}
      <span class="absolute top-1 right-1 flex h-3.5 w-3.5 pointer-events-none">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-400 border-2 border-white"></span>
      </span>
    </a>

  </div>
</aside>

<style>
  #floating-whatsapp {
    position: fixed !important;
    bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px)) !important;
    right: calc(1.25rem + env(safe-area-inset-right, 0px)) !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .whatsapp-fab-button {
    width: 3.5rem !important; /* 56px on mobile */
    height: 3.5rem !important;
    background-color: #25D366 !important;
    box-shadow: 0 10px 25px -3px rgba(37, 211, 102, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.25) !important;
  }

  .whatsapp-fab-button:hover {
    background-color: #20bd5a !important;
  }

  .whatsapp-fab-button:active {
    background-color: #1da850 !important;
  }

  @media (min-width: 640px) {
    #floating-whatsapp {
      bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px)) !important;
      right: calc(1.5rem + env(safe-area-inset-right, 0px)) !important;
    }
    .whatsapp-fab-button {
      width: 4rem !important; /* 64px on tablet/desktop */
      height: 4rem !important;
    }
  }

  @keyframes whatsapp-ripple {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.35;
    }
    100% {
      transform: scale(1.75);
      opacity: 0;
    }
  }

  .whatsapp-pulse-ring-1 {
    animation: whatsapp-ripple 2.4s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  .whatsapp-pulse-ring-2 {
    animation: whatsapp-ripple 2.4s cubic-bezier(0.24, 0, 0.38, 1) infinite;
    animation-delay: 0.8s;
  }
</style>
