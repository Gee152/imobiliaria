---
import { NEIGHBORHOODS } from '../data/properties';
import { MapPin, Trees, Coffee, Compass, Check } from 'lucide-react';

const extraNeighborhoods = [
  'Aflitos', 'Parnamirim', 'Santana', 'Monteiro', 'Casa Amarela', 'Torre'
];
---

<section id="regioes" class="py-20 md:py-28 bg-[#F2ECE3] border-y border-[#E5DBD0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 scroll-reveal-down">
      <div class="max-w-2xl">
        <div class="inline-flex items-center space-x-2 bg-white px-3.5 py-1.5 rounded-full border border-[#E5DBD0] mb-4">
          <span class="w-2 h-2 rounded-full bg-[#C85A32]" />
          <span class="text-xs uppercase tracking-widest text-[#4A2E22] font-semibold">
            Autoridade Local
          </span>
        </div>

        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-[#26160F] leading-tight mb-3">
          Conheço a Zona Norte do Recife.
        </h2>

        <p class="font-body text-base text-[#5A544F] leading-relaxed">
          Uma boa escolha imobiliária também depende de conhecer profundamente a região: a dinâmica do trânsito, a proximidade com escolas, a valorização das ruas e o perfil de cada vizinhança.
        </p>
      </div>

      <div class="mt-6 md:mt-0">
        <a
          href="#contato"
          class="inline-flex items-center space-x-2 bg-[#26160F] text-white px-5 py-3 rounded-xl text-xs font-semibold hover:bg-[#351F16] transition-colors touch-target"
        >
          <Compass className="w-4 h-4 text-[#C85A32]" />
          <span>Quero orientação sobre um bairro</span>
        </a>
      </div>
    </div>

    {/* Neighborhoods Cards - Mobile Horizontal Slider / Desktop Grid */}
    <div class="relative mb-12">
      <div 
        id="neighborhoods-slider"
        class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0 gap-4 sm:gap-6 pb-2 sm:pb-0 sm:grid sm:grid-cols-2 lg:grid-cols-3 sm:overflow-visible"
      >
        {NEIGHBORHOODS.map((n, index) => {
          const animClass = index % 3 === 0 
            ? 'scroll-reveal-left delay-100' 
            : index % 3 === 1 
            ? 'scroll-reveal-down delay-200' 
            : 'scroll-reveal-right delay-300';
          return (
            <div 
              class={`w-[85vw] max-w-[340px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink sm:snap-align-none bg-white rounded-2xl border border-[#E5DBD0] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between card-dynamic ${animClass}`}
            >
              <div>
                <div class="relative aspect-[16/10] overflow-hidden bg-[#FAF7F2]">
                  <img
                    src={n.image}
                    alt={`Bairro ${n.name} em Recife`}
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
                  
                  <div class="absolute bottom-3 left-4 right-4 text-white">
                    <span class="text-[11px] font-semibold text-[#C85A32] uppercase tracking-wider block mb-0.5">
                      Zona Norte
                    </span>
                    <h3 class="font-display text-xl font-bold">
                      {n.name}
                    </h3>
                  </div>
                </div>

                <div class="p-5">
                  <p class="text-xs font-semibold text-[#4A2E22] mb-2">
                    {n.tagline}
                  </p>
                  
                  <p class="text-xs text-[#6E6760] leading-relaxed mb-4">
                    {n.description}
                  </p>

                  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[#E5DBD0]">
                    {n.highlights.map((h) => (
                      <span class="text-[11px] px-2.5 py-1 rounded-md bg-[#FAF7F2] text-[#4A2E22] border border-[#E5DBD0]">
                        {h}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="p-5 pt-0">
                <a
                  href={`https://wa.me/5581997459932?text=Ol%C3%A1%2C%20Tatiana!%20Gostaria%20de%20ver%20op%C3%A7%C3%B5es%20de%20im%C3%B3veis%20no%20bairro%20${encodeURIComponent(n.name)}.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center space-x-1.5 py-2.5 rounded-xl bg-[#FAF7F2] hover:bg-[#F2ECE3] text-xs font-semibold text-[#26160F] transition-colors border border-[#E5DBD0]"
                >
                  <MapPin className="w-3.5 h-3.5 text-[#C85A32]" />
                  <span>Ver imóveis em {n.name}</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      {/* Mobile Slide Dots Indicator */}
      <div class="flex sm:hidden items-center justify-center space-x-2 mt-5" aria-label="Navegação dos bairros">
        {NEIGHBORHOODS.map((n, index) => (
          <button 
            type="button"
            aria-label={`Ir para bairro ${n.name}`}
            class={`transition-all duration-300 neighborhood-dot cursor-pointer ${index === 0 ? 'w-6 h-1.5 rounded-full bg-[#C85A32]' : 'w-1.5 h-1.5 rounded-full bg-[#E5DBD0]'}`}
            data-index={index}
          />
        ))}
      </div>
    </div>

    {/* Extended Neighborhood Badges (Hidden on mobile) */}
    <div class="hidden sm:flex bg-white p-6 rounded-2xl border border-[#E5DBD0] flex-col sm:flex-row items-center justify-between gap-4 scroll-reveal-up delay-200 card-dynamic">
      <div class="text-center sm:text-left">
        <span class="block text-xs uppercase font-bold text-[#6E6760] tracking-wider mb-1">
          Também atendo sob demanda em outros endereços nobres:
        </span>
        <div class="flex flex-wrap justify-center sm:justify-start gap-2 pt-1">
          {extraNeighborhoods.map((bairro) => (
            <span class="text-xs font-medium px-3 py-1 rounded-full bg-[#FAF7F2] border border-[#E5DBD0] text-[#26160F]">
              {bairro}
            </span>
          ))}
        </div>
      </div>

      <div class="text-xs text-[#6E6760] font-medium shrink-0">
        Disponibilidade confirmada sob consulta
      </div>
    </div>

  </div>
</section>

<script>
  const slider = document.getElementById('neighborhoods-slider');
  const dots = document.querySelectorAll('.neighborhood-dot');

  if (slider && dots.length > 0) {
    const updateDots = () => {
      const scrollPosition = slider.scrollLeft;
      const cardWidth = (slider.firstElementChild as HTMLElement)?.clientWidth || 300;
      const activeIndex = Math.min(
        dots.length - 1,
        Math.max(0, Math.round(scrollPosition / (cardWidth + 16)))
      );

      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('bg-[#C85A32]', 'w-6');
          dot.classList.remove('bg-[#E5DBD0]', 'w-1.5');
        } else {
          dot.classList.remove('bg-[#C85A32]', 'w-6');
          dot.classList.add('bg-[#E5DBD0]', 'w-1.5');
        }
      });
    };

    slider.addEventListener('scroll', updateDots, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIndex = Number(dot.getAttribute('data-index') || 0);
        const cardWidth = (slider.firstElementChild as HTMLElement)?.clientWidth || 300;
        slider.scrollTo({
          left: targetIndex * (cardWidth + 16),
          behavior: 'smooth'
        });
      });
    });
  }
</script>
